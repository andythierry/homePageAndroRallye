<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a1a">

    <!-- RACECHRONO - TRÈS GROS -->
    <Button
        android:id="@+id/btnRaceChronoHeader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:text="🏁\nRACE\nCHRONO"
        android:textSize="56sp"
        android:textColor="#00FF00"
        android:background="#1a3a1a"
        android:layout_margin="8dp"
        android:gravity="center" />

    <!-- RALLY CALL - GRAND -->
    <Button
        android:id="@+id/btnRallyCallHeader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:text="📝 RALLY CALL"
        android:textSize="32sp"
        android:textColor="#00FF00"
        android:background="#003300"
        android:layout_margin="8dp" />

    <!-- REC avec GPS (petit) -->
    <Button
        android:id="@+id/btnDataPause"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="📍 REC\n--.------\n--.------\n--.-- m/s"
        android:textSize="12sp"
        android:textColor="#00FF00"
        android:background="#004400"
        android:layout_margin="6dp"
        android:gravity="center" />

    <!-- Row: Camera | Bluetooth | Settings | Reboot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📷"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:background="#2a2a2a"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnBluetooth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔵"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:background="#2a2a2a"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:background="#2a2a2a"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnReboot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔄"
            android:textSize="20sp"
            android:textColor="#FF0000"
            android:background="#440000"
            android:layout_margin="2dp" />
    </LinearLayout>

</LinearLayout>
