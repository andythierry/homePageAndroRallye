<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a1a">

    <!-- HEADER: Heure (gros) + Batterie (icone + pourcentage vertical) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal"
        android:background="#000000"
        android:gravity="center_vertical|center_horizontal"
        android:padding="8dp">

        <!-- Heure (gauche, énorme) -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="00:00:00"
            android:textSize="72sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:gravity="left|center_vertical" />

        <!-- Batterie (droite, icone + pourcentage vertical) -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <!-- Icone batterie (énorme) -->
            <TextView
                android:id="@+id/ivBatteryIcon"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:text="🔋"
                android:textSize="80sp"
                android:gravity="center" />

            <!-- Pourcentage vertical (géant) -->
            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="100%"
                android:textSize="32sp"
                android:textColor="#00FF00"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.5" />
        </LinearLayout>
    </LinearLayout>

    <!-- RACECHRONO | RALLY CALL (côte à côte, égaux) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnRaceChronoHeader"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🏁\nRACE\nCHRONO"
            android:textSize="48sp"
            android:textColor="#00FF00"
            android:background="#1a3a1a"
            android:layout_margin="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnRallyCallHeader"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📝\nRALLY\nCALL"
            android:textSize="48sp"
            android:textColor="#00FF00"
            android:background="#003300"
            android:layout_margin="4dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- REC avec GPS -->
    <Button
        android:id="@+id/btnDataPause"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:text="📍 REC\n--.------\n--.------\n--.-- m/s"
        android:textSize="14sp"
        android:textColor="#00FF00"
        android:background="#004400"
        android:layout_margin="6dp"
        android:gravity="center" />

    <!-- Row: Camera | Bluetooth | Settings | Reboot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📷"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:background="#2a2a2a"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnBluetooth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔵"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:background="#2a2a2a"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:background="#2a2a2a"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnReboot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔄"
            android:textSize="20sp"
            android:textColor="#FF0000"
            android:background="#440000"
            android:layout_margin="2dp" />
    </LinearLayout>

</LinearLayout>
